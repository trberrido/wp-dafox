{
	"name": "df-blocks",
	"version": "0.1.0",
	"description": "Example block scaffolded with Create Block tool.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build:css": "sass --no-source-map --style=compressed src/styles:assets/styles",
		"build:blocks": "wp-scripts build --webpack-copy-php && wp-scripts build-blocks-manifest --input=assets/blocks",
		"package": "node scripts/package.mjs",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-copy-php"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.4.0",
		"sass": "^1.102.0"
	},
	"dependencies": {
		"@wordpress/server-side-render": "^5.12.0"
	}
}
